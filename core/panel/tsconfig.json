{
  // Runs in the browser (the webview): DOM, and no Node types.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "out/src",
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../i18n" }, { "path": "../reader" }]
}
