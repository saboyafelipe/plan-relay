{
  // The tests run in Node under vitest (globals), apart from the package code.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "out/test",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.test.ts"],
  "references": [{ "path": "." }, { "path": "../i18n" }]
}
