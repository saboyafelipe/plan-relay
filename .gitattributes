# LF line endings in every checkout, Windows included: the .sh scripts break with CRLF
# and the suite fixtures are compared byte for byte.
* text=auto eol=lf
*.sh text eol=lf
# Conformance fixtures that test a task saved with CRLF: kept byte for byte.
core/contract/conformance/cases/crlf/** -text
core/contract/conformance/edits/*-crlf/** -text
# The plugin generated by tools/build.sh: the diff that counts is the one in core/ and agents/.
dist/** linguist-generated=true
