{
  // Runs in the browser (the webview): DOM, and no Node types.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/webview",
    "outDir": "out/webview",
    "tsBuildInfoFile": "out/webview.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/webview/**/*.ts"],
  "exclude": ["src/webview/**/*.test.ts"],
  "references": [{ "path": "../../core/i18n" }, { "path": "../../core/panel" }]
}
